# ---------------------------------------------------------------------------
# GLOWA environment variables
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_) --------------------------
# Supabase secret key. Bypasses RLS. Server-side admin tasks only.
SUPABASE_SECRET_KEY=

# OpenAI, used server-side for asset generation and the AI assistant.
OPENAI_API_KEY=

# Google OAuth (calendar sync) - added in Prompt 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email. Without these the outbox still fills; in development it
# prints to the server log, in production it stays queued rather than
# pretending to have sent.
RESEND_API_KEY=
RESEND_FROM="GLOWA <bookings@example.com>"
RESEND_REPLY_TO=

# Shared secret for /api/cron/notifications. Server only.
CRON_SECRET=
